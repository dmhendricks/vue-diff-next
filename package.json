{
  "name": "vue-diff-next",
  "version": "1.3.0",
  "description": "A modern, lightweight diff viewer component for Vue 3.5+",
  "license": "MIT",
  "author": {
    "name": "Daniel M. Hendricks",
    "url": "https://github.com/dmhendricks"
  },
  "keywords": [
    "vue",
    "vue3",
    "diff",
    "diff-viewer",
    "code-diff",
    "syntax-highlighting",
    "vue-diff"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmhendricks/vue-diff-next.git"
  },
  "homepage": "https://dmhendricks.github.io/vue-diff-next/",
  "bugs": {
    "url": "https://github.com/dmhendricks/vue-diff-next/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./themes/visual-studio-light.css": "./dist/themes/visual-studio-light.css",
    "./themes/visual-studio-dark.css": "./dist/themes/visual-studio-dark.css",
    "./themes/monokai-dark.css": "./dist/themes/monokai-dark.css",
    "./themes/atom-dark.css": "./dist/themes/atom-dark.css",
    "./themes/atom-light.css": "./dist/themes/atom-light.css",
    "./themes/github-dark.css": "./dist/themes/github-dark.css",
    "./themes/github-light.css": "./dist/themes/github-light.css",
    "./themes/coral-dark.css": "./dist/themes/coral-dark.css",
    "./themes/coral-light.css": "./dist/themes/coral-light.css",
    "./themes/twilight-dark.css": "./dist/themes/twilight-dark.css",
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite -c vite.config.demo.ts",
    "build": "vue-tsc -p tsconfig.build.json --noEmit && vite build && node scripts/build-themes.js",
    "build:demo": "vite build -c vite.config.demo.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:browser": "vitest --run -c vitest.browser.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/check-size.js",
    "check:exports": "publint && attw --pack . --profile node16 --exclude-entrypoints style.css --exclude-entrypoints themes/visual-studio-light.css --exclude-entrypoints themes/visual-studio-dark.css --exclude-entrypoints themes/monokai-dark.css --exclude-entrypoints themes/atom-dark.css --exclude-entrypoints themes/atom-light.css --exclude-entrypoints themes/github-dark.css --exclude-entrypoints themes/github-light.css --exclude-entrypoints themes/coral-dark.css --exclude-entrypoints themes/coral-light.css --exclude-entrypoints themes/twilight-dark.css --ignore-rules cjs-resolves-to-esm",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run test:browser && npm run build && npm run size && npm run check:exports",
    "prepublishOnly": "npm run verify",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@speed-highlight/core": "^2.1.0",
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.2",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/browser": "^5.0.1",
    "@vitest/browser-playwright": "^5.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "sass-embedded": "^1.105.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "fsevents": true,
    "simple-git-hooks": true
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
