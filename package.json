{
  "name": "vue-diff-next",
  "version": "0.1.0",
  "description": "A modern, lightweight Vue 3 diff viewer — the maintained successor to vue-diff",
  "license": "MIT",
  "author": {
    "name": "Daniel M. Hendricks",
    "url": "https://github.com/dmhendricks"
  },
  "keywords": [
    "vue",
    "vue3",
    "diff",
    "diff-viewer",
    "code-diff",
    "syntax-highlighting",
    "vue-diff"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmhendricks/vue-diff-next.git"
  },
  "homepage": "https://dmhendricks.github.io/vue-diff-next/",
  "bugs": {
    "url": "https://github.com/dmhendricks/vue-diff-next/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite -c vite.config.demo.ts",
    "build": "vue-tsc -p tsconfig.build.json --noEmit && vite build",
    "build:demo": "vite build -c vite.config.demo.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/check-size.js",
    "check:exports": "publint && attw --pack . --profile node16 --exclude-entrypoints style.css",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run size && npm run check:exports",
    "prepublishOnly": "npm run verify"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@speed-highlight/core": "^1.2.23",
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.12",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "sass-embedded": "^1.100.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.9"
  }
}
